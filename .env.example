# ---- Server-only (never sent to the browser) ----
GOOGLE_PLACES_API_KEY=
PORT=4000
# Requests/second to Places API (default quota is 600/min for Text Search)
PLACES_RPS=5
# Estimated USD per 1000 Text Search (Enterprise fields) requests - for the usage panel only
PLACES_COST_PER_1000=35
# Hours to reuse identical Places responses (avoids paying twice for the same query)
PLACES_CACHE_TTL_HOURS=72
# Parallel website analyses
WEBSITE_CONCURRENCY=4
# Firecrawl API Key for website crawling and scraping
FIRECRAWL_API_KEY=

# ---- Browser key (Vite exposes VITE_* to the client) ----
# Restrict this key by HTTP referrer (http://localhost:5173/*) in Google Cloud Console.
VITE_GOOGLE_MAPS_JS_KEY=
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

{
  "name": "local-geni",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Geni: local business leads, external design links, email, and WhatsApp outreach",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "desktop": "electron desktop/main.cjs",
    "setup": "npm install && npm --prefix client install",
    "reset-login": "node --disable-warning=ExperimentalWarning server/reset-login.js",
    "test": "node --test server/*.test.js client/src/lib/*.test.js public-relay/test/*.test.mjs",
    "test:preview-ui": "node --disable-warning=ExperimentalWarning scripts/preview-qa-server.js",
    "test:email-ui": "node --disable-warning=ExperimentalWarning scripts/email-qa-server.js",
    "qa": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.40.0",
    "archiver": "5.3.2",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "imapflow": "^2.0.2",
    "libphonenumber-js": "^1.12.0",
    "mailparser": "^3.9.25",
    "nodemailer": "^10.0.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "44.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
